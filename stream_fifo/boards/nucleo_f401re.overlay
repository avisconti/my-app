#include <zephyr/dt-bindings/sensor/lsm6dsv16x.h>
#include <zephyr/dt-bindings/sensor/iis3dwb.h>


/*
 * Nucleo F401RE board + shield iks4a1
 *
 * This devicetree overlay file will be automatically picked by the Zephyr
 * build system when building the sample for the nucleo_f401re board.
 */

/ {
	aliases {
		//stream0 = &lsm6dsv16x_6b_x_nucleo_iks4a1;
		stream0 = &iis3dwb_0;
	};
};

&spi1 {
	iis3dwb_0: iis3dwb@0 {
		compatible = "st,iis3dwb";

		reg = <0>;
		spi-max-frequency = <DT_FREQ_M(20)>;

		range = <IIS3DWB_DT_FS_16G>;
		odr = <IIS3DWB_DT_ODR_26k7Hz>;
		filter = <IIS3DWB_DT_LP_ODR_DIV_4>;
		int1-gpios =  <&arduino_header 5 GPIO_ACTIVE_HIGH>; /* A5 (PC0) */
		drdy-pin = <1>;

		fifo-watermark = <128>;
		accel-fifo-batch-rate = <IIS3DWB_DT_XL_BATCHED_AT_26k7Hz>;
		temp-fifo-batch-rate = <IIS3DWB_DT_TEMP_NOT_BATCHED>;
		timestamp-fifo-batch-rate = <IIS3DWB_DT_TS_NOT_BATCHED>;
	};
};
